{
  "name": "airmetro",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "D1 Database",
      "database_name": "airmetro",
      "database_id": "a0e51445-95e9-40b7-8289-2c957aba5ee0"
    }
  ]
}
