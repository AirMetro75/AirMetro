{
  "name": "airmetro",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airmetro",
      "database_id": "COLLEZ-ICI-L-ID-DE-LA-BASE"
    }
  ]
}
